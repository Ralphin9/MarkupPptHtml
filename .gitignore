# Python environments
.venv/
.venv-omnivoice/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Local/editor noise
.vscode/
.DS_Store
Thumbs.db

# Secrets — never commit
.env
*.env.local
.env.example.png

# Hugging Face model cache (large)
.cache/

# Generated media caches can be very large; keep tracked media explicit if needed.
media/**/__pycache__/

# HyperFrames render/test outputs
my-video/.waveform-cache/
my-video/assets/
my-video/my-video/
my-video/output.mp4
my-video/renders/
my-video/work-*/
